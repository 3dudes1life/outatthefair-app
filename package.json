{
  "name": "outatthefair-app",
  "version": "0.4.0",
  "private": true,
  "description": "Out at the Fair\u00ae mobile-first PWA and Capacitor app foundation.",
  "scripts": {
    "serve": "python3 -m http.server 4173 --directory www",
    "cap:init": "npx cap init 'Out at the Fair' 'com.outatinc.outatthefair' --web-dir www",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
